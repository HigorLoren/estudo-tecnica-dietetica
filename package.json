{
  "name": "estudo-tecnica-dietetica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run lint && npm run typecheck && vite build",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
